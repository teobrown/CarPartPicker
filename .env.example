# Production / dev database. The Next.js app and live scraper read this.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Separate database used for running tests. MUST be different from DATABASE_URL.
# Tests truncate tables; pointing them at the wrong DB is destructive.
# Recommended: a second Neon project / a Neon branch / a local Postgres.
TEST_DATABASE_URL=postgresql://user:pass@host/dbname_test?sslmode=require
