# Production / dev database. The Next.js app and live scraper read this.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Separate database used for running tests. MUST be different from DATABASE_URL.
# Tests truncate tables; pointing them at the wrong DB is destructive.
# Recommended: a second Neon project / a Neon branch / a local Postgres.
TEST_DATABASE_URL=postgresql://user:pass@host/dbname_test?sslmode=require

# Clerk auth — required for Save Build / Share Build / dashboard.
# Provision a Clerk app at clerk.com -> API Keys -> copy both keys here.
# In production, also paste the keys into the Vercel project env vars.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Webhook signing secret — used by /api/webhooks/clerk to verify
# Clerk-delivered events (user.created, user.updated, user.deleted)
# come from Clerk and not a forged caller. Get it from the Clerk
# dashboard -> Webhooks -> your endpoint -> Signing secret.
CLERK_WEBHOOK_SECRET=whsec_...
